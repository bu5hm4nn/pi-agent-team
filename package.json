{
  "name": "@yiki21/pi-agent-team",
  "version": "0.4.1",
  "description": "Turn several machines running the Pi coding agent into one team over your tailnet. Four transports (broker / mesh / SWIM / hyperswarm), one shared API and conformance suite.",
  "license": "MIT",
  "author": "Yiki21",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "agent-mesh",
    "agent-team",
    "multi-agent",
    "tailscale",
    "coding-agent",
    "swim",
    "memberlist",
    "gossip"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pi-agent-team-broker": "broker.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "broker.mjs",
    "index.ts",
    "docs/",
    "skills/",
    "swim/main.go",
    "swim/go.mod",
    "swim/go.sum",
    "README.md",
    "LICENSE",
    "src/dispatch.js",
    "src/i18n.js",
    "src/locales/en-US.js",
    "src/locales/zh-Hans.js",
    "src/messages.js",
    "src/mode.js",
    "src/options.js",
    "src/session.js",
    "src/team-config.js",
    "src/transport-hyperswarm.js",
    "src/hyperswarm.d.ts",
    "src/transport-mesh.js",
    "src/transport-swim.js",
    "src/transport.js",
    "src/ws.js"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 \"src/**/*.test.js\" \"e2e/**/*.test.js\"",
    "test:unit": "node --test --test-timeout=30000 \"src/**/*.test.js\"",
    "test:e2e": "node --test --test-timeout=30000 \"e2e/**/*.test.js\"",
    "broker": "node broker.mjs",
    "build:sidecar": "cd swim && go build -o ../.tmp/swim-sidecar ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yiki21/pi-agent-team.git"
  },
  "bugs": {
    "url": "https://github.com/Yiki21/pi-agent-team/issues"
  },
  "homepage": "https://github.com/Yiki21/pi-agent-team#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "hyperswarm": "4.17.2"
  },
  "devDependencies": {
    "hyperdht": "6.34.0"
  }
}
